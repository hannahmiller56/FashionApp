{
  "name": "fashionapp-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:sandbox": "EXPO_PUBLIC_UI_SANDBOX=1 expo start",
    "start:sandbox:tunnel": "EXPO_PUBLIC_UI_SANDBOX=1 expo start --tunnel --clear",
    "web:sandbox": "EXPO_PUBLIC_UI_SANDBOX=1 expo start --web --clear",
    "web:sandbox:8090": "EXPO_PUBLIC_UI_SANDBOX=1 expo start --web --clear --port 8090",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:login": "eas login",
    "eas:build:android:dev": "eas build --platform android --profile development",
    "eas:version": "eas --version"
  },
  "dependencies": {
    "@expo-google-fonts/allura": "^0.4.2",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo-google-fonts/sacramento": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eas-cli": "^18.0.3",
    "typescript": "~5.9.2"
  }
}
